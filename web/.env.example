# Public configuration only. Never place staff credentials or tokens in VITE_* variables.
VITE_PROPERTY_API_URL=/api/v1
# Dev proxy target, used by the Vite server only (not embedded in the browser bundle).
PROPERTY_API_PROXY_TARGET=http://127.0.0.1:8081
# Existing stay/room booking website; this frontend adds public property browsing only.
VITE_STAY_SITE_URL=https://stayindandeli.in
