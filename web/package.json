    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.12.0",
    "prettier": "3.8.5",
    "typescript": "^5.8.3",
