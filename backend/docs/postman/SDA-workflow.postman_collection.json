{
  "info": {
    "_postman_id": "c4b17b47-cdbf-4dc8-82e4-f9dc4830718b",
    "name": "SDA — Complete integration workflow",
    "description": "Run on a disposable local/test or staging dataset with an explicitly authorized staff account. Creates fictional records and deletes only the captured fixture property/document; CRM contact/lead/enquiry/visit/deal audit history remains by API design. Choose the supplied environment, fill staff credentials and set document_file to the sample PDF for full coverage. No frontend or payment gateway is involved. See ../INTEGRATION.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Complete workflow",
      "item": [
        {
          "name": "01 Login and initialize isolated demo IDs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontend_origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staff_email}}\",\n  \"password\": \"{{staff_password}}\",\n  \"device_name\": \"Postman integration kit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('staff_email') || !pm.environment.get('staff_password')) throw new Error('Set staff_email and staff_password in the selected local/staging environment.');",
                  "['access_token','property_id','lead_id','user_id','enquiry_id','visit_id','task_id','note_id','document_id','deal_id','cancelled_deal_id'].forEach(k => pm.environment.unset(k));",
                  "const guid = () => pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('run_id', guid());",
                  "pm.environment.set('property_title', 'Integration fixture ' + pm.environment.get('run_id'));",
                  "pm.environment.set('submission_id', guid());",
                  "pm.environment.set('request_id', guid());",
                  "pm.environment.set('second_request_id', guid());",
                  "const iso = offset => new Date(Math.floor((Date.now() + offset) / 1000) * 1000).toISOString().replace('.000Z', 'Z');",
                  "pm.environment.set('visit_start', iso(172800000));",
                  "pm.environment.set('visit_end', iso(176400000));",
                  "pm.environment.set('visit_start_later', iso(180000000));",
                  "pm.environment.set('visit_end_later', iso(183600000));",
                  "pm.environment.set('task_due', iso(86400000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.environment.set(\"access_token\", String(pm.response.json().data.access_token));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Browser preflight",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontend_origin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": "{{base_url}}/admin/properties",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Configured browser origin\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.environment.get(\"frontend_origin\")));"
                ]
              }
            }
          ]
        },
