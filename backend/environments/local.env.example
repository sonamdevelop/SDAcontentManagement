# Example values to merge into an existing .env; tools/setup.sh creates local DB defaults.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
PROPERTY_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAIL_MAILER=log
DEBUGBAR_ENABLED=false
